# Variabel untuk docker-compose (deploy/dcloud/docker-compose.yml)
# Salin menjadi file ".env" di folder yang SAMA:
#   cp deploy/dcloud/compose.env.example deploy/dcloud/.env
# Lalu isi nilainya. JANGAN commit file .env ke repo.

# --- Kredensial root MongoDB (dipakai container "mongo") ---
MONGO_ROOT_USER=lmsadmin
MONGO_ROOT_PASSWORD=GANTI-password-mongo-kuat

# --- Jumlah worker Gunicorn per container backend ---
# Rumus: (2 x jumlah vCPU) + 1, dibagi jumlah replika backend.
# Contoh VPS 4 vCPU + 2 replika backend  -> 5 worker per container.
WEB_CONCURRENCY=5
