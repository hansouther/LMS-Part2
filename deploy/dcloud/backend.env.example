# Contoh backend/.env untuk produksi di DCloud — salin ke backend/.env lalu isi
# JANGAN commit file .env ke repository.

# ---- Database (bila pakai docker-compose, MONGO_URL di-override otomatis oleh compose) ----
MONGO_URL=mongodb://lmsadmin:GANTI-password@mongo:27017/?authSource=admin
DB_NAME=binara_lms

# ---- Admin awal (dibuat otomatis saat startup pertama) ----
ADMIN_EMAIL=admin@domain-anda.com
ADMIN_PASSWORD=GANTI-password-admin-kuat

# ---- Keamanan ----
JWT_SECRET=GANTI-random-64-karakter    # buat: openssl rand -hex 32
CORS_ORIGINS=https://domain-anda.com,https://www.domain-anda.com

# ---- Midtrans (Pembayaran Try Out & Kelas Online) ----
# Sandbox: https://dashboard.sandbox.midtrans.com  -> Settings -> Access Keys
# Production: https://dashboard.midtrans.com       -> Settings -> Access Keys
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ---- Opsional: email notifikasi (bila dipakai) ----
# RESEND_API_KEY=
# EMAIL_FROM=noreply@domain-anda.com
